---
import '../styles/global.css';
import { SITE, ADS, ANALYTICS, USP } from '../config/site';
import { CATEGORIES, LIVE_TOOLS } from '../data/tools';
import SupportBox from '../components/SupportBox.astro';
import { LANGS, langFromPath, useT, localize, unlocalize, isLocalizable, catText, toolText } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/compress-pdf". Used for the canonical URL. */
  path: string;
  /** JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  activeCategory?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Skip the brand suffix in <title> (home page). */
  rawTitle?: boolean;
  /** Analytics context. */
  pageType?: 'home' | 'hub' | 'tool' | 'content';
  tool?: string;
}

const { title, description, path, schema = [], activeCategory, noindex = false, ogImage = '/og.png', rawTitle = false, pageType = path === '/' ? 'home' : 'content', tool } = Astro.props;
const an = ANALYTICS.posthogKey ? JSON.stringify({ key: ANALYTICS.posthogKey, host: ANALYTICS.posthogHost, ecpm: ANALYTICS.estimatedEcpmUsd }) : '';
const fullTitle = rawTitle ? title : `${title} | ${SITE.name}`;
const canonical = SITE.url + (path === '/' ? '/' : path.replace(/\/$/, ''));
const ogUrl = ogImage.startsWith('http') ? ogImage : SITE.url + ogImage;
const popular = LIVE_TOOLS.filter((t) => t.popular).slice(0, 8);
const year = new Date().getFullYear();
const isProd = import.meta.env.PROD;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const L = (p: string) => localize(p, lang);
const meta = LANGS.find((l) => l.code === lang)!;
// Pages with translations (home, hubs, tool pages) get hreflang links and a language switcher that keeps the page.
const enPath = unlocalize(path);
const hasAlt = !noindex && isLocalizable(enPath);
const cfBeacon = ANALYTICS.cloudflareToken ? JSON.stringify({ token: ANALYTICS.cloudflareToken }) : '';
---
<!doctype html>
<html lang={meta.locale} data-alt={hasAlt ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasAlt && LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={SITE.url + (localize(enPath, l.code) === '/' ? '/' : localize(enPath, l.code))} />)}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={SITE.url + (enPath === '/' ? '/' : enPath)} />}
    {hasAlt && lang === 'en' && (
      <script is:inline>
        // A visitor who chose a language earlier sees that version (crawlers have no saved choice, so they always get English).
        try { var l = localStorage.getItem('lang'); if (l && /^(hi|bn|mr|te|ta)$/.test(l)) location.replace('/' + l + (location.pathname === '/' ? '' : location.pathname) + location.search + location.hash); } catch (e) {}
      </script>
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="search" type="application/opensearchdescription+xml" title={SITE.name} href="/opensearch.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {ADS.client && <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />}
    <slot name="head" />
  </head>
  <body data-page-type={pageType} data-tool={tool} data-category={activeCategory} data-lang={lang}>
    <a class="skip-link" href="#main">{t('Skip to content')}</a>
    <div class="usp-strip" role="note"><div class="container"><span class="usp-long">{lang === 'en' ? USP.strip : t('usp.strip')}</span><span class="usp-short">{lang === 'en' ? USP.stripShort : t('usp.stripShort')}</span></div></div>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={L('/')} aria-label={`${SITE.name} ${t('home')}`}>
          <span class="brand-mark" aria-hidden="true">✦</span>{SITE.name}
        </a>
        <nav class="cat-nav" aria-label="Tool categories">
          {CATEGORIES.map((c) => (
            <a href={L(c.path)} aria-current={activeCategory === c.id ? 'page' : undefined}>{catText(c, lang).label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <details class="lang-pick">
            <summary aria-label={`${t('Language')}: ${meta.native}`}>🌐 <span>{meta.native}</span></summary>
            <div class="lang-menu">
              {LANGS.map((l) => (
                <a href={hasAlt ? localize(enPath, l.code) : localize('/', l.code)} hreflang={l.code} lang={l.code} data-lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.native}<small>{l.english}</small></a>
              ))}
            </div>
          </details>
          <a class="header-cta" href="/support">☕ <span class="cta-text">{t('Support')}</span></a>
        </div>
      </div>
      <script is:inline>
        (function () { var n = document.querySelector('.cat-nav'), a = n && n.querySelector('[aria-current]'); if (a && n.scrollWidth > n.clientWidth) n.scrollLeft = a.offsetLeft - (n.clientWidth - a.offsetWidth) / 2; })();
        // Remember the language a visitor picks; close the menu when clicking elsewhere.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-lang]');
          if (a) { try { localStorage.setItem('lang', a.getAttribute('data-lang')); } catch (x) {} }
          document.querySelectorAll('details.lang-pick[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
        });
      </script>
    </header>

    <main id="main">
      <slot />
      <div class="container"><SupportBox t={t} /></div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href={L('/')}><span class="brand-mark" aria-hidden="true">✦</span>{SITE.name}</a>
            <p style="margin-top:10px">{lang === 'en' ? USP.long : t('usp.long')}</p>
            <p class="usp-foot"><span>🆓 {t('Free forever')}</span><span>👤 {t('No account, ever')}</span><span>🔒 {t('No data stored')}</span><span>📵 {t('Works offline')}</span><span>💻 {t('Open source')}</span></p>
            <p>{t('Contact')}: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
          <div>
            <h2>{t('Popular tools')}</h2>
            <ul>{popular.map((x) => <li><a href={L(`/${x.slug}`)}>{toolText(x, lang).name}</a></li>)}</ul>
          </div>
          <div>
            <h2>{t('Categories')}</h2>
            <ul>{CATEGORIES.map((c) => <li><a href={L(c.path)}>{t('{cat} tools', { cat: catText(c, lang).label })}</a></li>)}</ul>
          </div>
          <div>
            <h2>{t('About')}</h2>
            <ul>
              <li><a href="/about">{t('About us')}</a></li>
              <li><a href="/contact">{t('Contact')}</a></li>
              <li><a href="/roadmap">{t('Roadmap & requests')}</a></li>
              <li><a href="/support">{t('Support the project')}</a></li>
              <li><a href="/privacy-policy">{t('Privacy policy')}</a></li>
              <li><a href="/terms">{t('Terms of use')}</a></li>
              <li><a href={SITE.github} rel="noopener">{t('Source code (GitHub)')}</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} {SITE.name}. {t('footer.licence')}</span>
          <span>{t('Made in India for everyone.')}</span>
        </div>
      </div>
    </footer>

    {ADS.client && (
      <script is:inline define:vars={{ client: ADS.client }}>
        // Load AdSense after the page is interactive so it never delays the tool (Core Web Vitals).
        (function () {
          function pushSlots() {
            document.querySelectorAll('ins.adsbygoogle:not([data-pushed])').forEach(function (el) {
              if (el.offsetWidth === 0) return; // hidden (e.g. sidebar on mobile)
              el.setAttribute('data-pushed', '1');
              try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
            });
          }
          function load() {
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
            s.onload = pushSlots;
            document.head.appendChild(s);
          }
          var idle = window.requestIdleCallback || function (cb) { setTimeout(cb, 1200); };
          if (document.readyState === 'complete') idle(load); else addEventListener('load', function () { idle(load); });
          window.__pushAds = pushSlots;
        })();
      </script>
    )}
    {an && <script is:inline set:html={`window.__AN=${an};`} />}
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
    {isProd && cfBeacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeacon}></script>}
    {isProd && ANALYTICS.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4Id}`}></script>
        <script is:inline define:vars={{ id: ANALYTICS.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
    {isProd && (
      <script is:inline>
        if ('serviceWorker' in navigator) addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
      </script>
    )}
  </body>
</html>
