---
/**
 * Layout for every tool page. Gives each page, for free:
 *  - unique <title>/description/canonical (from src/data/tools.ts)
 *  - WebApplication + BreadcrumbList + FAQPage structured data
 *  - privacy badges, reserved ad slots, how-to steps, FAQ, related tools, support box
 * The tool UI goes in the default slot; long-form SEO copy goes in the "content" slot.
 */
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import ToolTile from '../components/ToolTile.astro';
import { SITE, ADS, USP } from '../config/site';
import { getTool, getCategory, relatedTools } from '../data/tools';
import { langFromPath, useT, localize, localizeHref, toolText, catText, toolKind } from '../i18n';

export interface Faq { q: string; a: string }
/** One-click "Popular uses": either set form fields (CSS selector -> value) or link to a pre-filled URL. */
export interface Preset { label: string; hint?: string; set?: Record<string, string | boolean>; href?: string; /** Stable id for ?preset= links (defaults to the slugified label). */ id?: string }
interface Props {
  slug: string;
  /** Override registry values (used by programmatic pages like /ssc-photo-resizer). */
  path?: string;
  title?: string;
  description?: string;
  h1?: string;
  /** One short line under the H1. Defaults to the tool's short text (or the lead's first sentence on landing pages). */
  tagline?: string;
  /** Longer intro; shown at the top of the guide section below the tool. */
  lead?: string;
  steps?: string[];
  faqs?: Faq[];
  /** Badges under the H1. */
  badges?: string[];
  /** Extra breadcrumb level label (for programmatic pages). */
  crumb?: string;
  /** One-click quick starts for the most common tasks. */
  presets?: Preset[];
  /** The page passes its own translated title/lead/steps/FAQs (exam and KB pages) instead of the generic ones. */
  localized?: boolean;
}

const tool = getTool(Astro.props.slug);
const cat = getCategory(tool.category);
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const en = lang === 'en';
const tt = toolText(tool, lang), ct = catText(cat, lang);
const props = Astro.props;
// Translated pages use the translated name and short text plus generic, accurate how-to steps and FAQs.
// The English long-form copy (content slot) is shown only on English pages.
const kind = toolKind(tool);
const {
  path = en ? `/${tool.slug}` : localize(`/${tool.slug}`, lang),
  title = en ? tool.title : `${tt.name} – ${t('tool.titleSuffix')}`,
  description = en ? tool.description : `${tt.short} ${t('tool.leadSuffix')}`,
  h1 = en ? tool.name : tt.name,
  lead = en ? tool.description : `${tt.short} ${t('tool.leadSuffix')}`,
  steps = [],
  faqs = [],
  badges: extraBadges = ['📵 Files never leave your device', '🚫 No watermark', '∞ No limits'],
  crumb,
  presets = [],
} = en ? props : props.localized ? { ...props, badges: props.badges ?? [`📵 ${t('Files never leave your device')}`, `🚫 ${t('No watermark')}`, `∞ ${t('No limits')}`], path: localize(props.path ?? `/${props.slug}`, lang), presets: props.presets?.map((p) => (p.href ? { ...p, href: localizeHref(p.href, lang) } : p)) } : { slug: props.slug, presets: props.presets?.map((p) => (p.href ? { ...p, href: localizeHref(p.href, lang) } : p)), steps: [1, 2, 3].map((i) => t(`steps.${kind}.${i}`)), faqs: ['free', 'upload', 'account', 'mobile'].map((k) => ({ q: t(`faq.${k}.q`), a: t(`faq.${k}.a`) })), badges: [`📵 ${t('Files never leave your device')}`, `🚫 ${t('No watermark')}`, `∞ ${t('No limits')}`] } as typeof props;
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
// The top of the page stays short: H1, one line, the tool. All reading text goes to the guide section below.
const firstSentence = (s: string) => (strip(s).match(/^(.{20,}?[.!?।])(\s|$)/)?.[1] ?? strip(s));
const isLanding = !!props.path && props.path !== `/${tool.slug}`;
const landingLine = isLanding ? firstSentence(lead) : '';
const tagline = (en || props.localized ? props.tagline : undefined) ?? (landingLine && landingLine.length <= 130 ? landingLine : tt.short);
const heroMeta = [t('Free forever'), t('No account, ever'), t(kind === 'file' ? 'Files never leave your device' : 'No data stored')];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const embedCode = kind === 'calc'
  ? `<iframe src="${SITE.url + path}?embed=1" title="${esc(h1)}" width="100%" height="900" style="border:0;max-width:820px" loading="lazy"></iframe>\n<p style="font-size:13px">Free <a href="${SITE.url + path}">${esc(h1)}</a> by ${SITE.name}</p>\n<script>addEventListener('message',function(e){if(e.origin==='${SITE.url}'&&e.data&&e.data.skH)document.querySelectorAll('iframe').forEach(function(f){if(f.contentWindow===e.source)f.style.height=e.data.skH+'px'})})</script>`
  : '';
// The USP badges always come first; page-specific badges follow (duplicates of the USP are dropped).
const usp = en ? USP.short : [`🆓 ${t('Free forever')}`, `👤 ${t('No account, ever')}`, `🔒 ${t('No data stored')}`];
const badges = [...usp, ...extraBadges.filter((b) => !/no login|no account|free forever|no data/i.test(b))];
const url = SITE.url + path;
const related = relatedTools(tool.slug);
const hasSidebar = !!(ADS.client && ADS.slots.sidebar) || (import.meta.env.DEV && ADS.showPlaceholdersInDev);
const L = (p: string) => localize(p, lang);

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: h1,
    url,
    description,
    applicationCategory: tool.category === 'finance' ? 'FinanceApplication' : 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('Home'), item: SITE.url + (en ? '/' : L('/')) },
      { '@type': 'ListItem', position: 2, name: t('{cat} tools', { cat: ct.label }), item: SITE.url + L(cat.path) },
      { '@type': 'ListItem', position: 3, name: h1, item: url },
    ],
  },
];
if (faqs.length && (en || props.localized)) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
  });
}
---
<Base title={title} description={description} path={path} schema={schema} activeCategory={cat.id} pageType="tool" tool={tool.slug}>
  <slot name="head" slot="head" />
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={L('/')}>{t('Home')}</a> › <a href={L(cat.path)}>{t('{cat} tools', { cat: ct.label })}</a> › {crumb ? <><a href={L(`/${tool.slug}`)}>{tt.name}</a> › {crumb}</> : <span>{h1}</span>}
    </nav>
    <div class={`tool-layout${hasSidebar ? '' : ' no-aside'}`}>
      <div>
        <header class="tool-hero">
          <h1>{h1}</h1>
          <p class="tagline" set:html={tagline} />
          <p class="hero-meta">{heroMeta.map((m) => <span>{m}</span>)}</p>
          {tool.desktopOnly && <p class="hint" style="margin:8px 0 0">💻 {t('desktopOnly')}</p>}
        </header>

        {presets.length > 0 && (
          <div class="quick" role="group" aria-label={t('Popular uses')}>
            <span class="quick-label">⚡ {t('One-click')}:</span>
            {presets.map((p) => p.href
              ? <a class="chip" href={p.href} title={p.hint}>{p.label}</a>
              : <button type="button" class="chip" data-preset={JSON.stringify(p.set ?? {})} data-preset-id={p.id ?? slugify(p.label)} title={p.hint}>{p.label}</button>)}
          </div>
        )}
        <section class="card tool-card" aria-label={h1}>
          <noscript><p class="status warn">{t('noscript')}</p></noscript>
          <slot />
        </section>
        <p class="embed-credit"><a href={url} target="_blank" rel="noopener">{h1} · {SITE.name} ↗</a></p>

        <AdSlot slot="belowTool" />

        {related.length > 0 && (
          <section class="related">
            <div class="section-head"><h2>{t('Related tools')}</h2><a href={L(cat.path)}>{t('All {cat} tools', { cat: en ? ct.label.toLowerCase() : ct.label })} →</a></div>
            <div class="tool-grid m-compact">{related.map((x) => <ToolTile tool={x} lang={lang} />)}</div>
          </section>
        )}

        <section class="guide" id="guide" aria-label={t('guide.label')}>
          <p class="guide-eyebrow">📖 {t('guide.label')}</p>
          <p class="guide-lead" set:html={lead} />
          <div class="trust">{badges.map((b) => <span>{b}</span>)}</div>
          {!en && <p class="hint lang-note">🌐 {t('lang.note')} <a href={props.localized && props.path ? props.path : `/${tool.slug}`} data-lang="en" hreflang="en">{t('Read in English')}</a></p>}
          <article class="prose">
            {(en || props.localized) && <slot name="content" />}
            {steps.length > 0 && (
              <>
                <h2>{t('How to use the {tool} tool', { tool: h1 })}</h2>
                <ol>{steps.map((s) => <li set:html={s} />)}</ol>
              </>
            )}
            <AdSlot slot="inContent" />
            <h2>{t('Why {site}?', { site: SITE.name })}</h2>
            <ul>
              <li set:html={t('why.free')} />
              <li set:html={t('why.account')} />
              <li set:html={t('why.data')} />
              <li set:html={t('why.offline')} />
              <li set:html={t('why.open').replace('GitHub', `<a href="${SITE.github}" rel="noopener">GitHub</a>`)} />
            </ul>
            {faqs.length > 0 && (
              <section class="faq">
                <h2>{t('Frequently asked questions')}</h2>
                {faqs.map((f) => (
                  <details>
                    <summary>{f.q}</summary>
                    <p set:html={f.a} />
                  </details>
                ))}
              </section>
            )}
            {embedCode && (
              <section class="embed-box">
                <h2>{t('embed.h2')}</h2>
                <p>{t('embed.p')}</p>
                <textarea class="embed-code" rows="5" readonly spellcheck="false" aria-label={t('embed.h2')}>{embedCode}</textarea>
                <button type="button" class="btn btn-sm" id="embed-copy" data-done={t('Copied')}>📋 {t('Copy code')}</button>
              </section>
            )}
          </article>
        </section>
      </div>
      {hasSidebar && (
        <aside class="tool-aside" aria-label="Sidebar">
          <AdSlot slot="sidebar" />
        </aside>
      )}
    </div>
  </div>
  <script>
    import { track } from '../lib/ui';
    import { toolStarted } from '../lib/analytics';
    function apply(btn: HTMLElement, scroll = true) {
      const set = JSON.parse(btn.dataset.preset || '{}') as Record<string, string | boolean>;
      for (const [sel, v] of Object.entries(set)) {
        document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
          if (el instanceof HTMLButtonElement || el.tagName === 'LABEL') { if (v) el.click(); return; }
          const input = el as HTMLInputElement;
          if (input.type === 'checkbox' || input.type === 'radio') input.checked = !!v;
          else input.value = String(v);
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
      document.querySelectorAll('.quick .chip').forEach((c) => c.classList.toggle('active', c === btn));
      track('preset_used', { preset: btn.dataset.presetId || '' });
      toolStarted('preset');
      const card = document.querySelector('.tool-card');
      if (scroll && card && card.getBoundingClientRect().top > innerHeight * 0.6) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    document.querySelectorAll<HTMLElement>('.quick [data-preset]').forEach((b) => b.addEventListener('click', () => apply(b)));
    // Translated pages: swap common English labels inside the tool (buttons, fields, results) for the visitor's language.
    const uiLang = document.body.dataset.lang;
    if (uiLang && uiLang !== 'en') {
      fetch(`/i18n/${uiLang}.json`).then((r) => r.json()).then((dict: Record<string, string>) => {
        const root = document.querySelector('.tool-card');
        if (!root) return;
        const tr = (node: Node) => {
          if (node.nodeType === 3) {
            const v = node.nodeValue || '', k = v.trim();
            if (k && dict[k] && !(node.parentElement?.closest('.ov-pages, textarea, [contenteditable], code, pre'))) node.nodeValue = v.replace(k, dict[k]);
            return;
          }
          if (node.nodeType !== 1) return;
          const el = node as Element;
          if (el.matches('.ov-pages, textarea, [contenteditable], script, style, code, pre')) return;
          for (const a of ['placeholder', 'aria-label', 'title']) { const v = el.getAttribute(a)?.trim(); if (v && dict[v]) el.setAttribute(a, dict[v]); }
          el.childNodes.forEach(tr);
        };
        tr(root);
        new MutationObserver((ms) => ms.forEach((m) => (m.type === 'characterData' ? tr(m.target) : m.addedNodes.forEach(tr)))).observe(root, { childList: true, subtree: true, characterData: true });
      }).catch(() => {});
    }
    // "Add this calculator to your website": copy the embed code.
    const embedBtn = document.getElementById('embed-copy');
    embedBtn?.addEventListener('click', async () => {
      const code = (document.querySelector('.embed-code') as HTMLTextAreaElement).value;
      try { await navigator.clipboard.writeText(code); } catch { (document.querySelector('.embed-code') as HTMLTextAreaElement).select(); }
      embedBtn.textContent = `✅ ${embedBtn.dataset.done}`;
      track('embed_code_copied');
    });
    // Embedded on another site (?embed=1): tell the host page our height so its iframe fits without scrollbars.
    if (document.documentElement.classList.contains('embed') && parent !== window) {
      const send = () => parent.postMessage({ skH: Math.ceil(document.documentElement.scrollHeight) }, '*');
      new ResizeObserver(send).observe(document.body);
      send();
    }
    const want = new URLSearchParams(location.search).get('preset');
    const match = want && document.querySelector<HTMLElement>(`.quick [data-preset-id="${CSS.escape(want)}"]`);
    if (match) setTimeout(() => apply(match, false), 0);
  </script>
</Base>
