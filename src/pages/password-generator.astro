---
import ToolLayout from '../layouts/ToolLayout.astro';
const faqs = [
  { q: 'Is it safe to generate a password online?', a: 'Here, yes. Passwords are generated in your browser with the operating system\'s cryptographically secure random generator (crypto.getRandomValues). Nothing is sent over the network or stored.' },
  { q: 'How long should my password be?', a: 'At least 12–16 characters for important accounts. Length matters more than complexity: a random 16-character password is practically impossible to brute-force.' },
  { q: 'Should I reuse passwords?', a: 'Never. Use a different password for every site and store them in a password manager. Turn on two-factor authentication for email and banking.' },
];
const steps = ['Choose the length and character types.', 'Press Generate (a new password is created instantly).', 'Copy it into your password manager.'];
---
<ToolLayout slug="password-generator" h1="Strong Password Generator" lead="Create strong, random passwords instantly with your device's secure random generator. Nothing is sent or stored, and you can check how strong any password is."
  presets={[{ label: '🔐 Strong (16 chars)', set: { '#pw-len': '16', '#pw-up': true, '#pw-low': true, '#pw-num': true, '#pw-sym': true } }, { label: '🛡️ Very strong (24)', set: { '#pw-len': '24', '#pw-up': true, '#pw-low': true, '#pw-num': true, '#pw-sym': true } }, { label: '📶 Wi-Fi friendly (no symbols)', set: { '#pw-len': '14', '#pw-sym': false, '#pw-amb': true } }, { label: '🔢 PIN (6 digits)', set: { '#pw-len': '6', '#pw-up': false, '#pw-low': false, '#pw-num': true, '#pw-sym': false } }]}
  steps={steps} faqs={faqs} badges={['🔒 Generated on your device', '🎲 Cryptographically secure']}>
  <div class="stack">
    <div class="result stack-sm"><code id="pw-out" style="font-size:1.35rem;word-break:break-all;background:transparent;padding:0"></code><div class="row"><button type="button" class="btn btn-primary" id="pw-copy">📋 Copy</button><button type="button" class="btn" id="pw-new">🎲 New password</button></div></div>
    <div class="grid-3">
      <div class="field"><label for="pw-len">Length: <output id="pw-lenv">16</output></label><input id="pw-len" type="range" min="4" max="64" value="16" /></div>
      <label class="check"><input type="checkbox" id="pw-up" checked /> A–Z</label>
      <label class="check"><input type="checkbox" id="pw-low" checked /> a–z</label>
      <label class="check"><input type="checkbox" id="pw-num" checked /> 0–9</label>
      <label class="check"><input type="checkbox" id="pw-sym" checked /> Symbols !@#$</label>
      <label class="check"><input type="checkbox" id="pw-amb" /> Avoid look-alikes (O0Il1)</label>
    </div>
    <p class="hint" id="pw-strength"></p>
    <div class="card stack-sm" style="box-shadow:none"><b>Check a password's strength</b><input id="pw-check" type="password" autocomplete="off" placeholder="Type a password (never leaves your device)" /><p class="hint" id="pw-check-out" style="margin:0"></p></div>
  </div>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const SETS = { up: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', low: 'abcdefghijklmnopqrstuvwxyz', num: '0123456789', sym: '!@#$%^&*()-_=+[]{};:,.?/~' };
    const AMB = /[O0Il1|`'"]/g;
    const rand = (n: number) => { const a = new Uint32Array(1); const lim = Math.floor(0x100000000 / n) * n; do crypto.getRandomValues(a); while (a[0] >= lim); return a[0] % n; };
    const label = (bits: number) => bits < 40 ? '🔴 Weak' : bits < 60 ? '🟠 Fair' : bits < 80 ? '🟢 Strong' : '🟢 Very strong';
    const crack = (bits: number) => { const s = Math.pow(2, bits) / 1e11 / 2; return s < 1 ? 'instantly' : s < 3600 ? `${Math.round(s / 60)} minutes` : s < 86400 * 365 ? `${Math.round(s / 86400)} days` : s < 3.15e7 * 1e6 ? `${Math.round(s / 3.15e7).toLocaleString('en-IN')} years` : 'millions of years+'; };
    function gen() {
      const pools = (['up', 'low', 'num', 'sym'] as const).filter((k) => $(`pw-${k}`).checked).map((k) => ($('pw-amb').checked ? SETS[k].replace(AMB, '') : SETS[k]));
      if (!pools.length) { $('pw-up').checked = true; return gen(); }
      const all = pools.join(''), n = +$('pw-len').value;
      const chars = pools.map((p) => p[rand(p.length)]); // at least one from each chosen set
      while (chars.length < n) chars.push(all[rand(all.length)]);
      for (let i = chars.length - 1; i > 0; i--) { const j = rand(i + 1); [chars[i], chars[j]] = [chars[j], chars[i]]; }
      const pw = chars.slice(0, n).join('');
      document.getElementById('pw-out')!.textContent = pw;
      const bits = n * Math.log2(all.length);
      document.getElementById('pw-strength')!.textContent = `${label(bits)} · ${Math.round(bits)} bits of entropy · would take ${crack(bits)} to guess at 100 billion guesses per second.`;
    }
    $('pw-len').addEventListener('input', () => { document.getElementById('pw-lenv')!.textContent = $('pw-len').value; gen(); });
    ['pw-up', 'pw-low', 'pw-num', 'pw-sym', 'pw-amb'].forEach((id) => $(id).addEventListener('change', gen));
    document.getElementById('pw-new')!.addEventListener('click', gen);
    document.getElementById('pw-copy')!.addEventListener('click', async () => { try { await navigator.clipboard.writeText(document.getElementById('pw-out')!.textContent!); document.getElementById('pw-copy')!.textContent = '✅ Copied'; setTimeout(() => (document.getElementById('pw-copy')!.textContent = '📋 Copy'), 1200); } catch {} });
    $('pw-check').addEventListener('input', () => {
      const s = $('pw-check').value;
      let pool = 0; if (/[a-z]/.test(s)) pool += 26; if (/[A-Z]/.test(s)) pool += 26; if (/\d/.test(s)) pool += 10; if (/[^a-zA-Z0-9]/.test(s)) pool += 32;
      let bits = s.length * Math.log2(Math.max(pool, 1));
      const common = /^(password|qwerty|123456|admin|welcome|iloveyou|india)/i.test(s) || /(.)\1{2,}/.test(s) || /(1234|abcd|qwer)/i.test(s);
      if (common) bits = Math.min(bits, 25);
      document.getElementById('pw-check-out')!.textContent = s ? `${label(bits)} · about ${Math.round(bits)} bits${common ? ' · contains a common pattern' : ''} · guessable in ${crack(bits)}.` : '';
    });
    gen();
  </script>
  <Fragment slot="content">
    <h2>Password tips</h2>
    <ul><li>Use a password manager (Bitwarden, 1Password, Apple/Google Password Manager) so you only remember one strong password.</li><li>Turn on two-factor authentication for email, banking and UPI apps.</li><li>Never share OTPs or passwords over phone or WhatsApp.</li></ul>
  </Fragment>
</ToolLayout>
