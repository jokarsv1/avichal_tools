---
import Page from '../layouts/Page.astro';
import { SITE, DONATE } from '../config/site';
const links = [
  DONATE.buyMeACoffee && { href: DONATE.buyMeACoffee, label: '☕ Buy Me a Coffee', note: 'Cards, Apple Pay, Google Pay' },
  DONATE.kofi && { href: DONATE.kofi, label: '💙 Ko-fi', note: 'PayPal and cards' },
  DONATE.githubSponsors && { href: DONATE.githubSponsors, label: '⭐ GitHub Sponsors', note: 'Monthly or one-time' },
  DONATE.paypalMe && { href: DONATE.paypalMe, label: '🅿️ PayPal', note: 'International donors' },
].filter(Boolean) as { href: string; label: string; note: string }[];
const upi = DONATE.upiId ? `upi://pay?pa=${encodeURIComponent(DONATE.upiId)}&pn=${encodeURIComponent(DONATE.upiName)}&cu=INR&tn=${encodeURIComponent('Support ' + SITE.name)}` : '';
---
<Page title="Support the project" description={`Help keep ${SITE.name} free, private and open source. Donate via UPI, Buy Me a Coffee, Ko-fi, GitHub Sponsors or PayPal.`} path="/support" h1="Support the project ☕">
  <p>{SITE.name} has no login, no paywall and no watermark, and it never will. If a tool saved you time or money, a small contribution helps pay for the domain, development time and new tools.</p>
  {upi ? (
    <div class="card stack-sm" style="max-width:560px">
      <h2 style="margin-top:0">🇮🇳 Pay with UPI (India)</h2>
      <div class="row">
        <canvas id="upi-qr" width="220" height="220" aria-label="UPI QR code" data-upi={upi} style="background:#fff;border-radius:10px"></canvas>
        <div class="stack-sm">
          <p style="margin:0">Scan with any UPI app, or tap the button on your phone.</p>
          <code>{DONATE.upiId}</code>
          <a class="btn btn-primary" href={upi}>Open UPI app</a>
        </div>
      </div>
    </div>
  ) : null}
  {links.length > 0 && (
    <div class="card stack-sm" style="max-width:560px;margin-top:16px">
      <h2 style="margin-top:0">🌍 International</h2>
      <div class="btn-row">{links.map((l) => <a class="btn" href={l.href} rel="noopener">{l.label}</a>)}</div>
    </div>
  )}
  {!upi && links.length === 0 && (
    <p class="callout">Donation links are coming soon. Meanwhile you can support us for free by starring the project on <a href={SITE.github} rel="noopener">GitHub</a> and sharing the tools with friends.</p>
  )}
  <h2>Other ways to help (free)</h2>
  <ul>
    <li>⭐ Star the <a href={SITE.github} rel="noopener">GitHub repository</a>.</li>
    <li>📣 Share a tool in your college, office or family WhatsApp group.</li>
    <li>🔗 Link to us from your blog, college website or resource page.</li>
    <li>🐞 <a href="/contact">Report bugs</a> or request new exam presets.</li>
  </ul>
  {upi && (
    <script>
      import { qrCanvas } from '../lib/qr';
      const c = document.getElementById('upi-qr') as HTMLCanvasElement;
      qrCanvas(c.dataset.upi!, 220, { fg: '#111111', bg: '#ffffff', ecc: 'M', margin: 1 }).then((q) => c.getContext('2d')!.drawImage(q, 0, 0, 220, 220));
    </script>
  )}
</Page>
