---
import ToolLayout from '../layouts/ToolLayout.astro';
import KbResizer from '../components/KbResizer.astro';
import { EXAMS, LAST_CHECKED, type Exam, type ImageSpec } from '../data/exams';
import { langFromPath, localize, usePageT, type Lang } from '../i18n';

export function getStaticPaths() {
  return EXAMS.map((exam) => ({ params: { exam: exam.slug }, props: { exam } }));
}
const { exam } = Astro.props as { exam: Exam };
const lang = langFromPath(Astro.url.pathname);
const en = lang === 'en';
const photo = exam.specs.find((s) => s.kind === 'photo');
const sign = exam.specs.find((s) => s.kind === 'signature');
const sz = (s?: typeof photo) => (s ? (s.minKB ? `${s.minKB}–${s.maxKB} KB` : `up to ${s.maxKB} KB`) : '');
const slugify = (x: string) => x.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const presets = exam.specs.map((sp) => { const label = sp.label.replace(exam.name + ' ', ''); return { label, id: slugify(label), set: { '.kb-preset': sp.id }, hint: sp.printed }; });

// ---------- English ----------
let title = `${exam.name} Photo & Signature Resizer – ${sz(photo)} Online`;
let description = `Resize your photo${sign ? ' and signature' : ''} for ${exam.fullName}: ${photo?.printed ?? ''}${sign ? `; signature ${sign.printed}` : ''}. Free, private, instant.`.slice(0, 160);
let h1 = `${exam.name} Photo & Signature Resizer`;
let lead = `Resize your photo and signature to the exact size for <b>${exam.fullName}</b>. Pick a preset, frame the photo and download.`;
let faqs = [
  { q: `What is the ${exam.name} photo size in KB?`, a: photo ? `${photo.printed}. The preset on this page applies it automatically.` : 'See the table above.' },
  ...(sign ? [{ q: `What is the ${exam.name} signature size?`, a: `${sign.printed}. Select the signature preset and keep "Clean signature" on for a white background.` }] : []),
  { q: 'What if the official notification shows different numbers?', a: `Follow the notification. Choose "Custom size…" and type the values. We last checked these specs in ${LAST_CHECKED}.` },
  { q: 'Is my photo uploaded to your server?', a: 'No. The photo is resized in your browser and never leaves your device.' },
];
let steps = [
  `Choose your photo (or signature) for the ${exam.name} form.`,
  `Pick the matching <b>${exam.name}</b> preset (photo, signature${exam.specs.length > 2 ? ', thumb or declaration' : ''}).`,
  'Drag and zoom to frame it, and check for the green <b>✓ Pass</b> badge.',
  `Download and upload it on <a href="${exam.officialSite}" rel="noopener nofollow">the official ${exam.name} site</a>.`,
];

// ---------- Translated (Hindi, Bengali, Marathi, Telugu, Tamil) ----------
const tp = en ? null : usePageT(lang as Exclude<Lang, 'en'>);
const lsz = (s?: ImageSpec) => (!tp || !s ? '' : s.minKB ? tp('range', { min: s.minKB, max: s.maxKB }) : tp('upTo', { max: s.maxKB }));
/** Printed specs are mostly numbers and units; translate the few English words in them. */
const lprinted = (s?: ImageSpec) => (!tp || !s?.printed ? '' : s.printed.replace('Passport size', tp('w.passport')).replace('at least', tp('w.atLeast')).replace(/\bwide\b/, tp('w.wide')).replace(/\bmax\b/, tp('w.max')));
const llabel = (s: ImageSpec) => `${exam.name} ${tp!(`kind.${s.kind}`)}${/\(([^)]+)\)$/.test(s.label) ? ` (${s.label.match(/\(([^)]+)\)$/)![1]})` : ''}`;
if (tp) {
  presets.forEach((pr, i) => { pr.label = llabel(exam.specs[i]).replace(`${exam.name} `, ''); });
  const v = { exam: exam.name, full: exam.fullName };
  title = tp('exam.title', { ...v, size: lsz(photo) });
  description = tp('exam.desc', { ...v, photo: lprinted(photo), sign: sign ? tp('exam.desc.sign', { sign: lprinted(sign) }) : '' }).slice(0, 170);
  h1 = tp('exam.h1', v);
  lead = tp('exam.lead', v);
  faqs = [
    ...(photo ? [{ q: tp('exam.faq.photo.q', v), a: tp('exam.faq.photo.a', { spec: lprinted(photo) }) }] : []),
    ...(sign ? [{ q: tp('exam.faq.sign.q', v), a: tp('exam.faq.sign.a', { spec: lprinted(sign) }) }] : []),
    { q: tp('exam.faq.change.q'), a: tp('exam.faq.change.a', { date: LAST_CHECKED }) },
    { q: tp('exam.faq.upload.q'), a: tp('exam.faq.upload.a') },
  ];
  steps = [tp('exam.step1', v), tp('exam.step2', v), tp('exam.step3'), tp('exam.step4', { ...v, link: `<a href="${exam.officialSite}" rel="noopener nofollow">${exam.officialSite.replace('https://', '')}</a>` })];
}
---
<ToolLayout presets={presets} slug="exam-photo-resizer" path={`/${exam.slug}-photo-resizer`} title={title} description={description}
  h1={h1} crumb={exam.name} lead={lead} steps={steps} faqs={faqs} localized={!en}>
  <KbResizer groups={[{ label: exam.name, specs: exam.specs }]} defaultId={exam.specs[0].id} />
  <Fragment slot="content">
    {tp ? (
      <>
        <h2>{tp('exam.table.h2', { exam: exam.name })}</h2>
        <table>
          <thead><tr><th>{tp('th.file')}</th><th>{tp('th.size')}</th><th>{tp('th.dims')}</th></tr></thead>
          <tbody>{exam.specs.map((s) => <tr><td>{llabel(s)}</td><td>{lsz(s)}</td><td>{lprinted(s)}</td></tr>)}</tbody>
        </table>
        <p class="callout">{tp('exam.checked', { date: LAST_CHECKED })} <a href={exam.officialSite} rel="noopener nofollow">{exam.officialSite.replace('https://', '')}</a></p>
        <h2>{tp('exam.tips.h2', { exam: exam.name })}</h2>
        <ul><li>{tp('exam.tip.photo')}</li><li>{tp('exam.tip.bg')}</li>{sign && <li>{tp('exam.tip.sign')}</li>}<li>{tp('exam.tip.check')}</li></ul>
        <h3>{tp('exam.others')}</h3>
        <p>{EXAMS.filter((e) => e.slug !== exam.slug).map((e, i) => <>{i ? ' · ' : ''}<a href={localize(`/${e.slug}-photo-resizer`, lang)}>{tp('exam.h1', { exam: e.name })}</a></>)}</p>
      </>
    ) : (
      <>
        <h2>{exam.name} photo and signature specifications</h2>
        <table>
          <thead><tr><th>File</th><th>File size</th><th>Dimensions</th></tr></thead>
          <tbody>{exam.specs.map((s) => <tr><td>{s.label}</td><td>{sz(s)}</td><td>{s.printed}</td></tr>)}</tbody>
        </table>
        <p class="callout">Last checked {LAST_CHECKED}. Specs can change with each notification, so confirm on <a href={exam.officialSite} rel="noopener nofollow">{exam.officialSite.replace('https://', '')}</a>.{exam.alsoFor ? ` ${exam.alsoFor}` : ''}</p>
        <h2>Instructions for {exam.name} uploads</h2>
        <ul>{exam.notes.map((n) => <li>{n}</li>)}</ul>
        <h3>Other exams</h3>
        <p>{EXAMS.filter((e) => e.slug !== exam.slug).map((e, i) => <>{i ? ' · ' : ''}<a href={`/${e.slug}-photo-resizer`}>{e.name} photo resizer</a></>)}</p>
      </>
    )}
  </Fragment>
</ToolLayout>
