---
import ToolLayout from '../layouts/ToolLayout.astro';
import Dropzone from '../components/Dropzone.astro';
const faqs = [
  { q: 'How do I extract specific pages from a PDF?', a: 'Choose <b>Extract pages</b> and type the pages you want, like <code>1-3, 5, 8-</code> ("8-" means page 8 to the end). You get one new PDF with only those pages.' },
  { q: 'How do I split a PDF into single pages?', a: 'Choose <b>Every page</b>. Each page becomes its own PDF, and all of them download together as a ZIP file.' },
  { q: 'Can I split a PDF into equal parts?', a: 'Yes. Choose <b>Every N pages</b> and enter N, for example 10 to split a 50-page PDF into five files.' },
  { q: 'Does splitting reduce quality?', a: 'No. Pages are copied exactly; nothing is re-compressed.' },
];
const steps = ['Choose a PDF.', 'Pick a mode: extract pages, custom ranges, every page, or every N pages.', 'Type the page numbers if needed.', 'Press <b>Split PDF</b>. Multiple files download as a ZIP.'];
---
<ToolLayout slug="split-pdf" h1="Split PDF" lead="Extract pages from a PDF or split it into several files by page ranges, single pages or equal parts. Free and private." steps={steps} faqs={faqs}>
  <div class="stack">
    <Dropzone id="sp-drop" accept=".pdf,application/pdf" title="Choose a PDF to split" icon="✂️" />
    <div id="sp-panel" class="stack-sm hidden">
      <p class="hint" id="sp-file"></p>
      <div class="seg" role="radiogroup" aria-label="Split mode">
        <label><input type="radio" name="sp-mode" value="extract" checked /><span>Extract pages</span></label>
        <label><input type="radio" name="sp-mode" value="ranges" /><span>Custom ranges</span></label>
        <label><input type="radio" name="sp-mode" value="each" /><span>Every page</span></label>
        <label><input type="radio" name="sp-mode" value="every" /><span>Every N pages</span></label>
      </div>
      <div class="field" id="sp-range-field"><label for="sp-range" id="sp-range-label">Pages</label><input id="sp-range" type="text" inputmode="numeric" placeholder="1-3, 5, 8-" /></div>
      <div class="field hidden" id="sp-every-field"><label for="sp-every">Pages per file</label><input id="sp-every" type="number" min="1" value="2" /></div>
      <div class="status" id="sp-status"></div>
      <div class="btn-row"><button type="button" class="btn btn-primary btn-lg" id="sp-go">Split PDF</button></div>
    </div>
  </div>
  <script>import '../tools/split-pdf';</script>
  <Fragment slot="content">
    <h2>Split a PDF without uploading it</h2>
    <p>Send only the pages someone needs, separate a scanned bundle into individual documents, or break a large report into chapters. Page numbers follow the order in the file; "8-" means "from page 8 to the end".</p>
    <p>Want to delete or reorder pages instead? Try <a href="/organize-pdf">Organize PDF</a>. To join files, use <a href="/merge-pdf">Merge PDF</a>.</p>
  </Fragment>
</ToolLayout>
