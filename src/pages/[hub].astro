---
import Base from '../layouts/Base.astro';
import ToolTile from '../components/ToolTile.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config/site';
import { CATEGORIES, toolsIn, type Category } from '../data/tools';
import { EXAMS, KB_PAGES } from '../data/exams';
import { langFromPath, useT, usePageT, localize, catText, toolText, type Lang } from '../i18n';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { hub: c.path.slice(1) }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: Category };
const tools = toolsIn(cat.id);
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const L = (p: string) => localize(p, lang);
const ct = catText(cat, lang);
const tp = lang === 'en' ? null : usePageT(lang as Exclude<Lang, 'en'>);
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: ct.title, description: ct.description, url: SITE.url + L(cat.path), inLanguage: lang },
  { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: tools.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: toolText(x, lang).name, url: SITE.url + L(`/${x.slug}`) })) },
];
---
<Base title={ct.title} description={ct.description} path={L(cat.path)} schema={schema} activeCategory={cat.id} pageType="hub">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={L('/')}>{t('Home')}</a> › {t('{cat} tools', { cat: ct.label })}</nav>
    <header class="tool-hero hub-hero">
      <h1>{cat.icon} {ct.title}</h1>
    </header>
    <div class="tool-grid">{tools.map((x) => <ToolTile tool={x} lang={lang} />)}</div>
    <AdSlot slot="belowTool" />
    <section class="guide" aria-label={t('guide.label')}>
      <p class="guide-eyebrow">📖 {t('guide.label')}</p>
      <p class="guide-lead">{ct.description}</p>
      {cat.id === 'exam' && (
        <div class="prose">
          <h2>{t('Exam-specific resizers')}</h2>
          <ul>{EXAMS.map((e) => <li><a href={L(`/${e.slug}-photo-resizer`)}>{tp ? tp('exam.h1', { exam: e.name }) : `${e.name} photo & signature resizer`}</a>: {e.fullName}</li>)}</ul>
          <h2>{t('Compress to a fixed size')}</h2>
          <ul>{KB_PAGES.map((p) => <li><a href={L(`/compress-image-to-${p.kb}kb`)}>{tp ? tp('kb.h1', { kb: p.kb }) : `Compress image to ${p.kb} KB`}</a></li>)}</ul>
        </div>
      )}
    </section>
  </div>
</Base>
