---
import ToolLayout from '../layouts/ToolLayout.astro';
const faqs = [
  { q: 'How do I embed a YouTube video on my website?', a: 'Paste the video link above, pick the options, press <b>Copy code</b> and paste the code into your page\'s HTML. In WordPress, add a "Custom HTML" block; in Blogger, switch the post to HTML view first.' },
  { q: 'How do I make a YouTube embed responsive?', a: 'Keep "Responsive" on. The code uses <code>width:100%</code> with <code>aspect-ratio:16/9</code> (9:16 for Shorts), so the video fills its column on phones and computers without black bars or overflow.' },
  { q: 'Why doesn\'t autoplay work with sound?', a: 'Chrome, Safari and Firefox block videos that start playing with sound. That\'s why the code adds <code>mute=1</code> whenever autoplay is on; visitors can unmute.' },
  { q: 'What is privacy-enhanced mode?', a: 'It loads the player from <code>youtube-nocookie.com</code>, so YouTube doesn\'t store cookies for your visitors until they press play. It\'s a good default for blogs and business sites.' },
  { q: 'How do I start or stop the video at a certain time?', a: 'Type the start and end times (like 1:30). The code adds <code>start</code> and <code>end</code> in seconds.' },
];
const steps = ['Paste the YouTube video link.', 'Choose the size, start time and player options.', 'Copy the code and paste it into your website.'];
---
<ToolLayout slug="youtube-embed-code-generator" h1="YouTube Embed Code Generator"
  lead="Make embed code for any YouTube video or Short: responsive size, start and end time, autoplay, loop, privacy-enhanced mode and more. Copy it into WordPress, Blogger or any HTML page."
  presets={[
    { label: '🧪 Try an example', set: { '#ye-url': 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' }, id: 'example' },
    { label: '🔁 Autoplay + loop (muted)', set: { '#ye-autoplay': true, '#ye-loop': true }, id: 'autoplay-loop' },
    { label: '⏱️ Start at 1:00', set: { '#ye-start': '1:00' }, id: 'start-1-00' },
    { label: '🕒 Timestamp link', href: '/youtube-timestamp-link-generator' },
  ]}
  steps={steps} faqs={faqs} badges={['📱 Responsive', '🔒 Privacy mode', '⏱️ Start & end time']}>
  <div class="stack">
    <div class="field">
      <label for="ye-url">YouTube link</label>
      <input id="ye-url" type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="Paste a YouTube link, e.g. https://www.youtube.com/watch?v=…" />
    </div>
    <div class="grid-2">
      <div class="field"><label for="ye-start">Start at (optional)</label><input id="ye-start" type="text" inputmode="numeric" placeholder="e.g. 1:30" autocomplete="off" /></div>
      <div class="field"><label for="ye-end">Stop at (optional)</label><input id="ye-end" type="text" inputmode="numeric" placeholder="e.g. 3:00" autocomplete="off" /></div>
    </div>
    <div class="row" style="gap:10px 18px">
      <label class="check"><input type="checkbox" id="ye-resp" checked /> Responsive (fits any screen)</label>
      <label class="check"><input type="checkbox" id="ye-privacy" checked /> Privacy-enhanced mode</label>
      <label class="check"><input type="checkbox" id="ye-autoplay" /> Autoplay (muted)</label>
      <label class="check"><input type="checkbox" id="ye-mute" /> Start muted</label>
      <label class="check"><input type="checkbox" id="ye-loop" /> Loop</label>
      <label class="check"><input type="checkbox" id="ye-nocontrols" /> Hide controls</label>
      <label class="check"><input type="checkbox" id="ye-cc" /> Captions on</label>
      <label class="check"><input type="checkbox" id="ye-rel" /> Related videos from this channel only</label>
    </div>
    <div class="grid-2" id="ye-size">
      <div class="field"><label for="ye-w">Width (px)</label><input id="ye-w" type="number" min="200" max="1920" value="560" /></div>
      <div class="field"><label for="ye-h">Height (px)</label><input id="ye-h" type="number" min="150" max="1080" value="315" /></div>
    </div>
    <p id="ye-status" class="status" role="status"></p>
    <div class="field">
      <label for="ye-code">Embed code</label>
      <textarea id="ye-code" rows="5" readonly spellcheck="false" style="font-family:var(--mono);font-size:.85rem" placeholder="Paste a link above to get the code."></textarea>
    </div>
    <div class="row">
      <button type="button" class="btn btn-primary" id="ye-copy" disabled>📋 Copy code</button>
      <button type="button" class="btn" id="ye-preview" disabled>▶ Preview</button>
    </div>
    <div id="ye-box" class="hidden" style="max-width:800px"></div>
  </div>
  <script>
    import { parseYouTube, parseTime, embedCode, type EmbedCodeOptions } from '../lib/youtube';
    import { setStatus, track } from '../lib/ui';
    import { toolStarted, taskCompleted } from '../lib/analytics';
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const code = document.getElementById('ye-code') as HTMLTextAreaElement;
    const st = document.getElementById('ye-status')!;
    const box = document.getElementById('ye-box')!;
    const copy = document.getElementById('ye-copy') as HTMLButtonElement;
    const prev = document.getElementById('ye-preview') as HTMLButtonElement;
    let started = false;
    const timeOf = (id: string) => { const v = $(id).value.trim(); return v ? parseTime(v) : undefined; };

    function update() {
      document.getElementById('ye-size')!.classList.toggle('hidden', $('ye-resp').checked);
      box.classList.add('hidden'); box.replaceChildren();
      const raw = $('ye-url').value.trim();
      const link = raw ? parseYouTube(raw) : null;
      copy.disabled = prev.disabled = !link;
      if (!link) { code.value = ''; setStatus(st, raw ? 'That doesn\'t look like a YouTube link.' : '', raw ? 'err' : 'info'); return; }
      if (!started) { started = true; toolStarted('input'); }
      const start = timeOf('ye-start') ?? link.t, end = timeOf('ye-end');
      const bad = [['ye-start', start], ['ye-end', end]].filter(([, v]) => v !== undefined && Number.isNaN(v as number));
      if (bad.length) { setStatus(st, 'Write times like 90, 1:30 or 1:02:03.', 'err'); return; }
      if (end !== undefined && start !== undefined && end <= start) { setStatus(st, 'The stop time must be after the start time.', 'err'); }
      else setStatus(st, link.isShort ? 'Short detected: the player is vertical (9:16).' : '');
      const o: EmbedCodeOptions = {
        start, end, responsive: $('ye-resp').checked, privacy: $('ye-privacy').checked, autoplay: $('ye-autoplay').checked,
        mute: $('ye-mute').checked, loop: $('ye-loop').checked, controls: !$('ye-nocontrols').checked, captions: $('ye-cc').checked,
        sameChannel: $('ye-rel').checked, vertical: !!link.isShort,
        ...($('ye-resp').checked ? {} : { width: +$('ye-w').value || undefined, height: +$('ye-h').value || undefined }),
      };
      code.value = embedCode(link.id, o);
    }
    document.querySelectorAll('.tool-card input').forEach((el) => { el.addEventListener('input', update); el.addEventListener('change', update); });
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(code.value); } catch { code.select(); }
      setStatus(st, '✅ Copied. Paste it into your page\'s HTML.', 'ok');
      taskCompleted('copy');
    });
    // The player loads only when asked, so this page stays fast and YouTube isn't contacted until then.
    prev.addEventListener('click', () => { box.innerHTML = code.value; box.classList.remove('hidden'); track('yt_embed_preview'); });
    update();
  </script>
  <Fragment slot="content">
    <h2>What each option does</h2>
    <table>
      <thead><tr><th>Option</th><th>Added to the code</th></tr></thead>
      <tbody>
        <tr><td>Start / stop time</td><td><code>start=90</code>, <code>end=180</code> (seconds)</td></tr>
        <tr><td>Autoplay</td><td><code>autoplay=1&amp;mute=1</code> (browsers only autoplay muted videos)</td></tr>
        <tr><td>Loop</td><td><code>loop=1&amp;playlist=VIDEO_ID</code> (YouTube needs both)</td></tr>
        <tr><td>Hide controls</td><td><code>controls=0</code></td></tr>
        <tr><td>Captions on</td><td><code>cc_load_policy=1</code></td></tr>
        <tr><td>Related videos from this channel</td><td><code>rel=0</code></td></tr>
        <tr><td>Privacy-enhanced mode</td><td>Player from <code>youtube-nocookie.com</code></td></tr>
      </tbody>
    </table>
    <p>The code includes <code>loading="lazy"</code>, so the player only loads when a visitor scrolls to it. That keeps your page fast, which also helps your Google ranking.</p>
    <p>Related: <a href="/youtube-timestamp-link-generator">YouTube timestamp link</a> · <a href="/youtube-thumbnail-downloader">YouTube thumbnail downloader</a> · <a href="/qr-code-generator">QR code for a video link</a></p>
    <p class="hint">SaralKit is not affiliated with YouTube or Google.</p>
  </Fragment>
</ToolLayout>
