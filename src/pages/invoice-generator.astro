---
import ToolLayout from '../layouts/ToolLayout.astro';
import BillingDoc from '../components/BillingDoc.astro';
const faqs = [
  { q: 'What must a GST invoice contain?', a: 'Supplier name, address and GSTIN; a unique invoice number and date; buyer name and address (and GSTIN if registered); HSN/SAC codes; quantity, rate and taxable value; the GST rate and amount split into CGST + SGST (same state) or IGST (different state); place of supply; total in figures and words; and a signature.' },
  { q: 'When is IGST charged instead of CGST + SGST?', a: 'When the supplier\'s state and the place of supply (usually the buyer\'s state) are different. The generator switches automatically when you choose the states.' },
  { q: 'Can I add a UPI QR code to the invoice?', a: 'Yes. Enter your UPI ID and the invoice gets a "Scan to pay" QR with the exact amount, so customers can pay instantly with any UPI app.' },
  { q: 'Is my business data saved?', a: 'Your business details and the last invoice number are saved only in this browser, so the next invoice is quicker. Nothing is uploaded.' },
  { q: 'Is this valid for e-invoicing?', a: 'Businesses above the e-invoicing turnover threshold must generate an IRN on the government IRP portal. This tool creates regular tax invoices for smaller businesses and freelancers. For price quotes, use the <a href="/quotation-generator">quotation generator</a>.' },
];
const steps = ['Fill in your business details (saved for next time).', 'Add the customer and choose both states (sets CGST/SGST or IGST).', 'Add items with HSN/SAC, quantity, rate and GST %.', 'Optionally add your UPI ID for a pay-now QR, then download the PDF.'];
---
<ToolLayout slug="invoice-generator" h1="GST Invoice Generator" lead="Create a professional GST tax invoice with automatic CGST/SGST or IGST, amount in words and a UPI pay-now QR. Download as PDF. Free, no login." steps={steps} faqs={faqs} badges={['🇮🇳 GST compliant fields', '📲 UPI QR on invoice', '💾 Saves your details', '✅ No login']}>
  <BillingDoc kind="invoice" />
  <Fragment slot="content">
    <h2>A free GST invoice maker for small businesses and freelancers</h2>
    <p>Most invoice apps ask you to sign up, add their logo, or limit you to a few invoices a month. This one runs in your browser, remembers your business details on your device, and creates a clean A4 PDF with every field a GST tax invoice needs, plus a UPI QR code with the exact amount so customers can pay in seconds.</p>
    <p>Check rates with the <a href="/gst-calculator">GST calculator</a>, send a <a href="/quotation-generator">quotation</a> first, or create a standalone <a href="/upi-qr-code-generator">UPI QR poster</a> for your counter.</p>
  </Fragment>
</ToolLayout>
