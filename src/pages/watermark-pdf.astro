---
import ToolLayout from '../layouts/ToolLayout.astro';
import Dropzone from '../components/Dropzone.astro';
const faqs = [
  { q: 'How do I add a watermark to a PDF?', a: 'Choose your PDF, type the watermark text (for example CONFIDENTIAL or "Copy for bank use only"), adjust colour, opacity and angle, and press <b>Add watermark</b>.' },
  { q: 'Can I watermark in Hindi or other languages?', a: 'Yes. The watermark is drawn with your device\'s fonts, so Hindi, Tamil, Bengali, Arabic and other scripts work.' },
  { q: 'Why watermark ID copies?', a: 'Writing the purpose and date on copies of your Aadhaar, PAN or passport (e.g. "For KYC at XYZ Bank only, 12/2026") makes misuse harder if the copy leaks.' },
  { q: 'Can the watermark be removed?', a: 'It is drawn onto every page. A determined person with PDF editing software could remove it, so for sensitive documents also consider flattening (print to PDF or PDF to JPG).' },
];
const steps = ['Choose a PDF.', 'Type the watermark text and pick colour, opacity, angle and layout.', 'Press <b>Add watermark</b>.'];
---
<ToolLayout presets={[{"label": "🔒 CONFIDENTIAL", "set": {"#st-text": "CONFIDENTIAL", "#st-color": "#e11d48", "#st-layout": "center"}}, {"label": "🪪 For KYC only (ID copies)", "set": {"#st-text": "For KYC purpose only - not valid for any other use", "#st-color": "#1d4ed8", "#st-layout": "tile", "#st-opacity": "22"}}, {"label": "📝 DRAFT", "set": {"#st-text": "DRAFT", "#st-color": "#64748b", "#st-layout": "center"}}, {"label": "📄 COPY", "set": {"#st-text": "COPY", "#st-color": "#0f766e", "#st-layout": "tile"}}]} slug="watermark-pdf" h1="Watermark PDF" lead="Stamp text such as CONFIDENTIAL, DRAFT or 'For KYC only' across every page. Supports any language. Free and private." steps={steps} faqs={faqs}>
  <div class="stack" data-stamp data-mode="watermark">
    <Dropzone id="st-drop" accept=".pdf,application/pdf" title="Choose a PDF" icon="💧" />
    <div id="st-panel" class="stack-sm hidden">
      <p class="hint" id="st-file"></p>
      <div class="field"><label for="st-text">Watermark text</label><input id="st-text" type="text" value="CONFIDENTIAL" maxlength="80" /></div>
      <div class="grid-4">
        <div class="field"><label for="st-color">Colour</label><input id="st-color" type="color" value="#e11d48" /></div>
        <div class="field"><label for="st-opacity">Opacity %</label><input id="st-opacity" type="number" min="5" max="100" value="25" /></div>
        <div class="field"><label for="st-angle">Angle °</label><input id="st-angle" type="number" min="-90" max="90" value="45" /></div>
        <div class="field"><label for="st-layout">Layout</label><select id="st-layout"><option value="center">Centre</option><option value="tile">Tiled</option></select></div>
        <div class="field"><label for="st-scale">Size (% of page width)</label><input id="st-scale" type="number" min="10" max="100" value="60" /></div>
      </div>
      <div class="status" id="st-status"></div>
      <div class="btn-row"><button type="button" class="btn btn-primary btn-lg" id="st-go">Add watermark</button></div>
    </div>
  </div>
  <script>import '../tools/pdf-stamp';</script>
  <Fragment slot="content">
    <h2>Protect copies of your documents</h2>
    <p>Before sending copies of ID documents, salary slips or bank statements, add a watermark stating who it is for and why. Tiled watermarks are harder to crop out. Light colours at 20–30% opacity keep the document readable.</p>
  </Fragment>
</ToolLayout>
