---
import ToolLayout from '../layouts/ToolLayout.astro';
import PdfLock from '../components/PdfLock.astro';
const faqs = [
  { q: 'What is the e-Aadhaar PDF password?', a: 'The first 4 letters of your name in CAPITAL letters followed by your year of birth (YYYY). Example: name Suresh Kumar, born 1990 → <code>SURE1990</code>.' },
  { q: 'What if my name has fewer than 4 letters?', a: 'Use the whole name in capitals followed by the birth year, e.g. <code>RAM1985</code> or <code>JO1992</code>.' },
  { q: 'My name has an initial or a space, what then?', a: 'Use the first 4 letters exactly as printed on the Aadhaar, ignoring spaces and dots. For "K. Ravi", try <code>KRAV</code> + year.' },
  { q: 'Is it safe to unlock Aadhaar here?', a: 'Yes. The file and your details stay in your browser and are never uploaded. Still, share your Aadhaar only where it is required, or use the masked Aadhaar from UIDAI.' },
  { q: 'Why remove the password at all?', a: 'Many portals, banks and print shops can\'t open password-protected files. An unlocked copy uploads and prints without problems.' },
];
const steps = ['Choose your e-Aadhaar PDF (downloaded from UIDAI).', 'Type your name and birth year in the helper, or the password directly.', 'Download the unlocked copy.'];
---
<ToolLayout slug="unlock-pdf" path="/aadhaar-pdf-password" crumb="e-Aadhaar password" title="e-Aadhaar PDF Password: Open & Remove It (Free, No Upload)" description="What is the e-Aadhaar PDF password? First 4 letters of your name in capitals + birth year. Open it, or remove the password and save an unlocked copy, on your device."
  h1="e-Aadhaar PDF Password: Open or Remove It" lead="Your e-Aadhaar password is the <b>first 4 letters of your name in CAPITALS + year of birth</b> (e.g. SURE1990). Enter your name and year below to unlock the PDF and save a copy without a password. Nothing is uploaded."
  steps={steps} faqs={faqs} badges={['🪪 Aadhaar helper', '🔐 Never uploaded']}>
  <PdfLock mode="unlock" aadhaar />
</ToolLayout>
