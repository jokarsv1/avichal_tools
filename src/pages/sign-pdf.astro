---
import ToolLayout from '../layouts/ToolLayout.astro';
import Dropzone from '../components/Dropzone.astro';
const faqs = [
  { q: 'How do I sign a PDF for free without an account?', a: 'Choose your PDF, draw your signature with a mouse or finger (or type it, or upload a photo of it), press <b>Add to page</b>, drag it into place and press <b>Download signed PDF</b>.' },
  { q: 'Is this a legally valid e-signature?', a: 'This adds an image of your signature (an "electronic signature"), which is accepted for many everyday documents such as forms, rental agreements and declarations. Some documents, such as certain government filings in India, require a digital signature certificate (DSC) or Aadhaar eSign instead. Check what the recipient accepts.' },
  { q: 'Can I use a photo of my signature?', a: 'Yes. Choose <b>Upload</b> and pick a photo of your signature on white paper. The paper is made transparent automatically.' },
  { q: 'Is my signature stored anywhere?', a: 'No. Your signature and the PDF stay in your browser and are not saved or uploaded. Closing the tab erases them.' },
  { q: 'Can I add the date or my name too?', a: 'Yes. Use <b>Add date</b> or <b>Add text</b> to place today\'s date, your name, initials or place on any page.' },
];
const steps = ['Choose the PDF you need to sign.', 'Draw, type or upload your signature.', 'Scroll to the right page and press <b>Add to page</b>.', 'Drag the signature into place; drag the corner to resize.', 'Press <b>Download signed PDF</b>.'];
---
<ToolLayout slug="sign-pdf" h1="Sign PDF" lead="Draw, type or upload your signature and place it anywhere on a PDF. No sign-up, no upload, no watermark." steps={steps} faqs={faqs}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Dancing+Script:wght@600&family=Great+Vibes&family=Satisfy&display=swap" />
  <div class="stack">
    <Dropzone id="sg-drop" accept=".pdf,application/pdf" title="Choose a PDF to sign" icon="✍️" />
    <div id="sg-panel" class="stack hidden">
      <div class="card stack-sm" style="box-shadow:none">
        <div class="row">
          <div class="seg" role="group" aria-label="Signature type">
            <button type="button" data-tab="draw" aria-pressed="true">Draw</button>
            <button type="button" data-tab="type" aria-pressed="false">Type</button>
            <button type="button" data-tab="upload" aria-pressed="false">Upload</button>
          </div>
          <span class="spacer"></span>
          <div class="seg" role="group" aria-label="Ink colour">
            <button type="button" data-ink="#0a1f8f" aria-pressed="true">Blue</button>
            <button type="button" data-ink="#111111" aria-pressed="false">Black</button>
          </div>
        </div>
        <div data-pane="draw" class="stack-sm">
          <canvas id="sg-pad" aria-label="Signature pad: draw your signature here"></canvas>
          <div class="row"><label class="field" style="flex:1">Pen thickness <input id="sg-thick" type="range" min="2" max="10" value="4" /></label><button type="button" class="btn btn-sm" id="sg-clear">Clear</button></div>
        </div>
        <div data-pane="type" class="grid-2 hidden">
          <div class="field"><label for="sg-typed">Your name</label><input id="sg-typed" type="text" placeholder="Type your name" /></div>
          <div class="field"><label for="sg-font">Style</label>
            <select id="sg-font"><option value="'Dancing Script'">Dancing Script</option><option value="'Great Vibes'">Great Vibes</option><option value="Satisfy">Satisfy</option><option value="Caveat">Caveat</option></select></div>
        </div>
        <div data-pane="upload" class="field hidden"><label for="sg-upload">Photo of your signature on white paper</label><input id="sg-upload" type="file" accept="image/*,.heic" /></div>
        <div class="btn-row">
          <button type="button" class="btn btn-primary" id="sg-add">➕ Add to page</button>
          <button type="button" class="btn" id="sg-add-all">Add to all pages</button>
          <button type="button" class="btn" id="sg-add-date">📅 Add date</button>
          <button type="button" class="btn" id="sg-add-text">🔤 Add text</button>
        </div>
      </div>
      <div class="status" id="sg-status"></div>
      <div id="sg-pages" class="sg-pages"></div>
      <div class="btn-row sg-savebar"><button type="button" class="btn btn-primary btn-lg" id="sg-save">⬇ Download signed PDF</button></div>
    </div>
  </div>
  <style is:global>
    #sg-pad { width: 100%; background: #fff; border: 1px dashed var(--border); border-radius: 12px; touch-action: none; cursor: crosshair; display: block; }
    .sg-pages { display: grid; gap: 18px; justify-items: center; background: var(--surface-2); padding: 14px; border-radius: 12px; max-height: 80vh; overflow: auto; }
    .sg-page { position: relative; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.18); max-width: 100%; }
    .sg-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    .sg-pno { position: absolute; top: -2px; left: 6px; font-size: .75rem; color: #888; }
    .sg-item { position: absolute; outline: 1.5px dashed #4f46e5; cursor: move; touch-action: none; }
    .sg-item img { width: 100%; height: 100%; display: block; pointer-events: none; user-select: none; }
    .sg-del { position: absolute; top: -12px; right: -12px; width: 24px; height: 24px; border-radius: 50%; border: 0; background: #e11d48; color: #fff; cursor: pointer; font-size: 12px; }
    .sg-resize { position: absolute; right: -7px; bottom: -7px; width: 16px; height: 16px; background: #4f46e5; border-radius: 4px; cursor: nwse-resize; }
    .sg-savebar { position: sticky; bottom: 10px; justify-content: center; }
  </style>
  <script>import '../tools/sign-pdf';</script>
  <Fragment slot="content">
    <h2>Sign documents in seconds, privately</h2>
    <p>Rental agreements, offer letters, school forms and declarations often just need your signature. Instead of printing, signing and scanning, sign the PDF directly in your browser. Your signature never leaves your device and is not stored after you close the page.</p>
    <p>Tip: use <a href="/signature-resizer">the signature cleaner</a> first if your photographed signature has shadows.</p>
  </Fragment>
</ToolLayout>
