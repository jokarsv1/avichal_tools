---
import type { Tool } from '../data/tools';
import { type Lang, toolText, localize } from '../i18n';
interface Props { tool: Tool; lang?: Lang }
const { tool, lang = 'en' } = Astro.props;
const { name, short } = toolText(tool, lang);
---
<a class="tool-tile" href={localize(`/${tool.slug}`, lang)} data-search={`${name} ${short} ${tool.name} ${tool.short} ${tool.keywords ?? ''}`.toLowerCase()}>
  <span class="ti" aria-hidden="true">{tool.icon}</span>
  <span><b>{name}</b><span>{short}</span></span>
</a>
