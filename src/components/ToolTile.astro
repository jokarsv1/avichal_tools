---
import type { Tool } from '../data/tools';
interface Props { tool: Tool }
const { tool } = Astro.props;
---
<a class="tool-tile" href={`/${tool.slug}`} data-search={`${tool.name} ${tool.short} ${tool.keywords ?? ''}`.toLowerCase()}>
  <span class="ti" aria-hidden="true">{tool.icon}</span>
  <span><b>{tool.name}</b><span>{tool.short}</span></span>
</a>
